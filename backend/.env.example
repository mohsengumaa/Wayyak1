DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=replace-with-strong-secret
DEBUG=False
ALLOWED_HOSTS=wayyak.mb-smart-systems.com

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mb_tourism
DB_USER=mb_user
DB_PASSWORD=replace-with-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS / CSRF
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://wayyak.mb-smart-systems.com
CSRF_TRUSTED_ORIGINS=https://wayyak.mb-smart-systems.com

# Security
SECURE_SSL_REDIRECT=True
